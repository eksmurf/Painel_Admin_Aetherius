{
  "name": "aetherius-admin-panel",
  "version": "0.1.1",
  "private": true,
  "description": "Painel administrativo ingame Aetherius para SkyMP",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:mysql": "node tests/mysql.integration.cjs",
    "test:ui": "node tests/ui.integration.cjs",
    "preview": "node scripts/preview.cjs",
    "package": "node scripts/package.cjs",
    "integrate:check": "node scripts/integrate.cjs --check",
    "integrate": "node scripts/integrate.cjs --apply"
  }
}
